# Copy to .env. Leave GEMINI_API_KEY empty to run fully offline with the local fallback.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MOCK_LLM=0          # 1 = never call the API (safe demo mode)
DEMO_DELAY=0.7      # seconds per stage so the live view is watchable; 0 = instant
# Production (Render disk). Leave unset locally.
# DB_PATH=/var/data/vendor.db
# UPLOAD_DIR=/var/data/uploads
# RULE_CONFIG_FILE=/var/data/rule_config.json
